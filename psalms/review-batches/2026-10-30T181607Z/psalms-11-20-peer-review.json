    },
    {
      "source_reference": "Psalms 20:6",
      "target": null,
      "reason": "The king’s glory, salvation and promised magnificence are preserved; a general statement that God grants honor does not furnish a particular additional match here.",
      "source_unit_read": true,
      "source_and_necessary_context_read": true,
      "completed_source_credit": 0,
      "completed_pair_credit": 0
    },
    {
      "source_reference": "Psalms 20:9",
      "target": null,
      "reason": "The first clause asks that the addressed person’s hand be found by enemies; the second asks that the right hand find all who hate the addressee. Neither the direction of the first action nor the unspecified addressee is replaced by familiar wording.",
      "source_unit_read": true,
      "source_and_necessary_context_read": true,
      "completed_source_credit": 0,
      "completed_pair_credit": 0
    },
    {
      "source_reference": "Psalms 20:14",
      "target": null,
