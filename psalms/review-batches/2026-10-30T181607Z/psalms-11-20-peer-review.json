  "deferred_source_units": [
    {
      "source_reference": "Psalms 11:1",
      "target": null,
      "reason": "The heading concerning the eighth and the David attribution are preserved; a repeated generic title alone does not receive a separate substantive connection.",
      "source_unit_read": true,
      "source_and_necessary_context_read": true,
      "completed_source_credit": 0,
      "completed_pair_credit": 0
    },
    {
      "source_reference": "Psalms 11:8",
      "target": null,
      "reason": "The assurance that the Lord will keep and preserve us from this generation and for ever is preserved; no more particular additional counterpart is retained beyond that common assurance of protection.",
      "source_unit_read": true,
      "source_and_necessary_context_read": true,
      "completed_source_credit": 0,
      "completed_pair_credit": 0
    },
    {
      "source_reference": "Psalms 11:9",
      "target": null,
      "reason": "The ungodly walking around and the Lord holding humanity in high regard according to His height are preserved without replacing the second clause with a familiar exaltation-of-vileness reading.",
      "source_unit_read": true,
      "source_and_necessary_context_read": true,
      "completed_source_credit": 0,
      "completed_pair_credit": 0
    },
    {
      "source_reference": "Psalms 12:1",
      "target": null,
      "reason": "The generic liturgical heading is preserved without separate connection credit.",
      "source_unit_read": true,
      "source_and_necessary_context_read": true,
      "completed_source_credit": 0,
      "completed_pair_credit": 0
    },
    {
      "source_reference": "Psalms 12:3",
      "target": null,
      "reason": "The repeated questions about inner counsel, daily heart-pain and the enemy being raised remain distinct; no particular episode or additional counterpart is established.",
      "source_unit_read": true,
      "source_and_necessary_context_read": true,
      "completed_source_credit": 0,
      "completed_pair_credit": 0
    },
    {
      "source_reference": "Psalms 13:6",
      "target": null,
      "reason": "The poor man’s shamed counsel and hope in the Lord are preserved; no specific counsel or historical poor person is identified by a generic poverty-and-hope comparison.",
      "source_unit_read": true,
      "source_and_necessary_context_read": true,
      "completed_source_credit": 0,
      "completed_pair_credit": 0
    },
    {
      "source_reference": "Psalms 15:1",
      "target": null,
      "reason": "The inscription and plea for guarding because of hope in the Lord are preserved; no additional specific connection is retained from the general protection formula.",
      "source_unit_read": true,
      "source_and_necessary_context_read": true,
      "completed_source_credit": 0,
      "completed_pair_credit": 0
    },
    {
      "source_reference": "Psalms 15:3",
      "target": null,
      "reason": "The holy ones in His land and His wonderful purposes among them are not assigned a particular named group or event by analogy.",
      "source_unit_read": true,
      "source_and_necessary_context_read": true,
      "completed_source_credit": 0,
      "completed_pair_credit": 0
    },
    {
      "source_reference": "Psalms 15:4",
      "target": null,
      "reason": "The gatherings of bloodshed and refusal to remember names remain as supplied. They are not rewritten as blood drink-offerings or assigned the identity of other gods; the naming comparison remains a separate zero-credit candidate.",
      "source_unit_read": true,
      "source_and_necessary_context_read": true,
      "completed_source_credit": 0,
      "completed_pair_credit": 0
    },
    {
      "source_reference": "Psalms 15:7",
      "target": null,
      "reason": "The understanding given by the Lord and the kidneys’ discipline until night remain exact; no definite prophetic revelation or outside identity for that inward discipline is supplied.",
      "source_unit_read": true,
      "source_and_necessary_context_read": true,
      "completed_source_credit": 0,
      "completed_pair_credit": 0
    },
    {
      "source_reference": "Psalms 16:4",
      "target": null,
      "reason": "Human deeds, words of God’s lips and hard paths are preserved without changing the hard paths into a familiar reference to paths of violent people.",
      "source_unit_read": true,
      "source_and_necessary_context_read": true,
      "completed_source_credit": 0,
      "completed_pair_credit": 0
    },
    {
      "source_reference": "Psalms 16:6",
      "target": null,
      "reason": "Calling, being heard and asking for an inclined ear are preserved; the general prayer-attention formula alone receives no additional connection credit.",
      "source_unit_read": true,
      "source_and_necessary_context_read": true,
      "completed_source_credit": 0,
      "completed_pair_credit": 0
    },
    {
      "source_reference": "Psalms 16:9",
      "target": null,
      "reason": "The enemies surrounding the speaker’s soul remain unnamed; a generic encirclement image does not identify a particular siege or hostile assembly.",
      "source_unit_read": true,
      "source_and_necessary_context_read": true,
      "completed_source_credit": 0,
      "completed_pair_credit": 0
    },
    {
      "source_reference": "Psalms 16:10",
      "target": null,
      "reason": "The statement that they shut up their fat is not silently converted into a description of unfeeling hearts; no particular counterpart to the complete wording is retained.",
      "source_unit_read": true,
      "source_and_necessary_context_read": true,
      "completed_source_credit": 0,
      "completed_pair_credit": 0
    },
    {
      "source_reference": "Psalms 16:11",
      "target": null,
      "reason": "The eyes set to turn aside toward the earth are not rewritten into an explicit plan to throw the speaker to the ground; the exact relationship of the clauses remains unresolved.",
      "source_unit_read": true,
      "source_and_necessary_context_read": true,
      "completed_source_credit": 0,
      "completed_pair_credit": 0
    },
    {
      "source_reference": "Psalms 16:13",
      "target": null,
      "reason": "The command to intercept and trip the enemies and the request concerning God’s sword are preserved. The ungodly man is not identified as God’s sword from a different familiar wording.",
      "source_unit_read": true,
      "source_and_necessary_context_read": true,
      "completed_source_credit": 0,
      "completed_pair_credit": 0
    },
    {
      "source_reference": "Psalms 16:14",
      "target": null,
      "reason": "The few, earthly life, hidden things, filled belly, sons and remains for infants remain exact; they are not harmonized into a familiar statement that worldly people have their portion only in this life.",
      "source_unit_read": true,
      "source_and_necessary_context_read": true,
      "completed_source_credit": 0,
      "completed_pair_credit": 0
    },
    {
      "source_reference": "Psalms 16:15",
      "target": null,
      "reason": "Appearance before God in righteousness and satisfaction when His glory appears are preserved without adding awakening from death or identifying a particular resurrection event.",
      "source_unit_read": true,
      "source_and_necessary_context_read": true,
      "completed_source_credit": 0,
      "completed_pair_credit": 0
    },
    {
      "source_reference": "Psalms 18:1",
      "target": null,
      "reason": "The generic heading supplies no separate substantive counterpart.",
      "source_unit_read": true,
      "source_and_necessary_context_read": true,
      "completed_source_credit": 0,
      "completed_pair_credit": 0
    },
    {
      "source_reference": "Psalms 18:3",
      "target": null,
      "reason": "Day’s utterance to day and night’s announcement to night remain the particular poetic sequence; a general creation-teaches motif does not establish an additional close counterpart in this pass.",
      "source_unit_read": true,
      "source_and_necessary_context_read": true,
      "completed_source_credit": 0,
      "completed_pair_credit": 0
    },
    {
      "source_reference": "Psalms 18:4",
      "target": null,
      "reason": "The actual statement that there are no utterances or words whose voices are not heard is preserved. It is not changed into wordless or inaudible speech; the direct Romans quotation is retained for the following source unit.",
      "source_unit_read": true,
      "source_and_necessary_context_read": true,
      "completed_source_credit": 0,
      "completed_pair_credit": 0
    },
    {
      "source_reference": "Psalms 18:12",
      "target": null,
      "reason": "The servant’s keeping and great recompense are preserved; no particular reward is identified from a generic obedience-and-blessing passage.",
      "source_unit_read": true,
      "source_and_necessary_context_read": true,
      "completed_source_credit": 0,
      "completed_pair_credit": 0
    },
    {
      "source_reference": "Psalms 18:14",
      "target": null,
      "reason": "The source asks to be spared from others and their rule. Others is not silently replaced by presumptuous sins; the proposed comparison with Romans’ explicit rule of sin remains unresolved and earns zero credit.",
      "source_unit_read": true,
      "source_and_necessary_context_read": true,
      "completed_source_credit": 0,
      "completed_pair_credit": 0
    },
    {
      "source_reference": "Psalms 19:1",
      "target": null,
      "reason": "The generic heading is preserved without a separate supported connection.",
      "source_unit_read": true,
      "source_and_necessary_context_read": true,
      "completed_source_credit": 0,
      "completed_pair_credit": 0
    },
    {
      "source_reference": "Psalms 19:9",
      "target": null,
      "reason": "Their being fettered and falling, contrasted with our rising and being set upright, is preserved without identifying a particular battle or importing another passage’s named parties.",
      "source_unit_read": true,
      "source_and_necessary_context_read": true,
      "completed_source_credit": 0,
      "completed_pair_credit": 0
    },
    {
      "source_reference": "Psalms 20:1",
      "target": null,
      "reason": "The generic heading is preserved without separate substantive connection credit.",
      "source_unit_read": true,
      "source_and_necessary_context_read": true,
      "completed_source_credit": 0,
